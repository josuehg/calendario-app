# Copia este archivo a ".streamlit/secrets.toml" (mismo nombre de carpeta, sin ".example")
# y completa con tus datos reales. NUNCA subas secrets.toml a GitHub.
# Si despliegas en Streamlit Community Cloud, en vez de un archivo pegas esto mismo
# en: tu app > Settings > Secrets.

SUPABASE_URL = "https://TU-PROYECTO.supabase.co"
SUPABASE_SERVICE_KEY = "tu-service-role-key-aqui"

# Contraseña simple compartida para entrar a la app (protege el enlace público).
# Cámbiala por una que solo tú y tus sucursales conozcan.
APP_PASSWORD = "cambia-esta-clave"
